{
  "name": "lucid-keeperhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Settles Lucid Agents x402 payments through KeeperHub, keyed by the payment identifier Lucid already enforces, and finalized only on a receipt reconciled against the chain.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run compile && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "settle": "tsx src/cli.ts settle",
    "compile": "node scripts/compile.mjs",
    "deploy": "node scripts/deploy.mjs",
    "plan": "tsx src/cli.ts plan",
    "demo": "tsx src/firewall/demo.ts",
    "prerender": "esbuild src/web/demo.ts --bundle --format=iife --target=es2022 --minify --outfile=public/demo.js",
    "vercel-build": "npm run prerender",
    "execute": "tsx src/firewall/execute.ts",
    "agent": "tsx examples/lucid-agent/server.ts",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@ethereumjs/common": "^4.4.0",
    "@ethereumjs/tx": "^5.4.0",
    "@ethereumjs/util": "^9.1.0",
    "@ethereumjs/vm": "^8.1.1",
    "@hono/node-server": "^2.1.1",
    "@keeperhub/mcp": "^0.1.1",
    "@keeperhub/sdk": "^0.1.1",
    "@lucid-agents/core": "^5.0.0",
    "@lucid-agents/hono": "^1.0.2",
    "@lucid-agents/http": "^4.0.0",
    "@lucid-agents/payments": "^5.0.0",
    "@lucid-agents/types": "^3.0.0",
    "hono": "^4.13.8",
    "solc": "^0.8.37",
    "viem": "^2.56.7",
    "zod": "^4.4.3"
  }
}
