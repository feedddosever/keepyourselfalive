# Organization key, prefix kh_ (Settings → API Keys → Organisation).
# A wfb_ user key is for webhook triggers only and will be rejected.
KH_API_KEY=kh_...

# mcp  — carries simulate and idempotency_key through to KeeperHub (preferred)
# rest — official SDK; no simulate and no idempotency key, so the preflight
#        falls back to a local eth_call and exactly-once rests on the ledger
KH_TRANSPORT=mcp

CHAIN_ID=84532
TOKEN_ADDRESS=0x...
DISPERSER_ADDRESS=0x...

# The address KeeperHub broadcasts from. The local preflight impersonates it, so
# a wrong value makes the simulation meaningless.
SENDER_ADDRESS=0x...

# Required for KH_TRANSPORT=rest.
RPC_URL=https://sepolia.base.org

# Positive balances below this carry into the next epoch instead of being paid.
# 10000 = 0.01 USDC at 6 decimals.
DUST_THRESHOLD=10000

SETTLEMENT_INTERVAL_MS=3600000
TIPS_PATH=state/tips.jsonl
LEDGER_PATH=state/epochs.json

# Deployment only (scripts/deploy.mjs); never needed by the agent itself.
DEPLOYER_PRIVATE_KEY=0x...
