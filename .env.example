# Copy this file to `.env` and paste your key below.
#
# Get it from KeeperHub: Settings → API Keys → Organisation.
# It must start with kh_ — a wfb_ key is for webhooks only and will be rejected.
KH_API_KEY=kh_paste_your_key_here

# Everything below is optional; the defaults are fine for a demo run.
# CHAIN_ID=84532
# PAY_TO=0x000000000000000000000000000000000000bEEF
# PRICE_ETH=0.0000001
# PORT=3210
